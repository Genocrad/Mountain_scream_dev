// ============================================================================
//   .\ShaderCompiler.exe -little "mountain_vertical_shader" "mountain_vertical_shader.vs" "mountain_vertical_shader.ps" "mountain_vertical_shader.ksh" -oglsl
// ============================================================================

#ifdef GL_ES
precision mediump float;
#endif







uniform mat4 MatrixW;


#if defined( TRIPLE_ATLAS )
    uniform sampler2D SAMPLER[6];
#else
    uniform sampler2D SAMPLER[5];
#endif

#ifndef LIGHTING_H
#define LIGHTING_H

#if !defined( UI_CC )
// Lighting
varying vec3 PS_POS;
varying vec4 PS_CLIP_POS;
varying vec3 PS_REVEAL_CENTRE;
varying vec2 PS_NDC_TO_VIEW;
varying vec2 PS_REVEAL_PLANE;
varying vec3 PS_WALL_FADE;
#endif

// xy = min, zw = max
uniform vec4 LIGHTMAP_WORLD_EXTENTS;

#define LIGHTMAP_TEXTURE SAMPLER[3]

#ifndef LIGHTMAP_TEXTURE
	#error If you use lighting, you must #define the sampler that the lightmap belongs to
#endif

#if defined( UI_CC )
vec3 CalculateLightingContribution(vec2 pos)
{
	vec2 uv = ( pos - LIGHTMAP_WORLD_EXTENTS.xy ) * LIGHTMAP_WORLD_EXTENTS.zw;
	return texture2D( LIGHTMAP_TEXTURE, uv.xy ).rgb;
}
#else
vec3 CalculateLightingContribution()
{
	vec2 uv = ( PS_POS.xz - LIGHTMAP_WORLD_EXTENTS.xy ) * LIGHTMAP_WORLD_EXTENTS.zw;
	return texture2D( LIGHTMAP_TEXTURE, uv.xy ).rgb;
}

vec3 CalculateLightingContribution( vec3 normal )
{
	return vec3( 1, 1, 1 );
}
#endif

#endif //LIGHTING.h


varying vec3 PS_TEXCOORD;

uniform vec4 TIMEPARAMS;

uniform mat4 COLOUR_XFORM;
uniform vec3 PARAMS;
uniform vec4 HAUNTPARAMS;
uniform vec4 HAUNTPARAMS2;
uniform vec4 OCEAN_BLEND_PARAMS;
uniform vec3 CAMERARIGHT;

#define ALPHA_TEST PARAMS.x
#define LIGHT_OVERRIDE PARAMS.y
#define BLOOM_TOGGLE PARAMS.z

#if defined( FADE_OUT ) || defined( HAUNT )
    varying vec2 FADE_UV;
#endif


#if defined( FADE_OUT )

	#if defined( HOLO )
		#define HOLO_SAMPLER			SAMPLER[2]
		#define HOLO_ERODE_INTENSITY	EROSION_PARAMS.x
		#define HOLO_Y_CUTOFF			EROSION_PARAMS.y
		#define NEGATIVE_HOLO_LERP		EROSION_PARAMS.z
	#else
    	#define ERODE_SAMPLER			SAMPLER[2]
		#define EROSION_MIN				EROSION_PARAMS.x
		#define EROSION_RANGE			EROSION_PARAMS.y
		#define EROSION_LERP			EROSION_PARAMS.z
	#endif
#endif

uniform vec4 OCEAN_WORLD_EXTENTS;
#define OCEAN_SAMPLER SAMPLER[4]

#if defined( HOLO )
	float filmSkipRand() // This should match the function with the same name in anim.vs
	{
		float steps = 12.;
		float c = fract(sin(ceil(TIMEPARAMS.x * steps) / steps) * 10000.);
		return (c * -.36) * step(.78, c);
	}
#endif

// See-through tuning, in world units. Keep the two level shapes in sync with
// ms_wall_occlusion.lua, which fades wall props the same way.
// Level 1, always on: start distances at the screen centre and edges.
const float NEAR_CENTRE_START = 4.0;      // view depth where centre pixels begin fading
const float NEAR_EDGE_START = 4.0;        // view depth where edge pixels begin fading
const float NEAR_SOFT = 0.3;               // blend over +-30% of the limit
// Fade at fixed world heights; mountain walls stand on the Y=0 ground plane.
const float TOP_FADE_END = 1536.0 * 0.0033 * 4.0; // full wall height: 20.2752
const float TOP_FADE_START = TOP_FADE_END - 2.0;  // half a tile below the top
const float TOP_KEEP = 0.0;               // fully transparent at and above the top
// Level 2, while the player is hidden: a camera-facing ellipse around the player.
const vec2 REVEAL_RADII = vec2(18.0, 12.0); // horizontal/vertical radii at the centre's depth
const float REVEAL_CORE = 0.5;             // share of the radii fully open
const float REVEAL_DEPTH = 4.0;            // view depth behind the upright plane at ellipse centre
const float REVEAL_DEPTH_SOFT = 1.0;       // blend on either side of the depth limit
const float FILL_KEEP = 0.1;               // paint left
const float INK_KEEP = 0.45;               // ink lines left
const float INK_BLUR_BIAS = 3.0;           // mip bias of the local paint average
const vec3 LUMA = vec3(0.299, 0.587, 0.114);

// Level 1. Blend the start distances smoothly from the centre to the edges.
float NearFade(vec2 screen_pos)
{
    float from_centre = length(screen_pos * vec2(PS_NDC_TO_VIEW.x / PS_NDC_TO_VIEW.y, 1.0));
    float fade_start = mix(NEAR_CENTRE_START, NEAR_EDGE_START, smoothstep(0.0, 1.0, from_centre));
    // The configured start distance is the far edge of the soft band.
    float limit = fade_start / (1.0 + NEAR_SOFT);
    return 1.0 - smoothstep(limit * (1.0 - NEAR_SOFT), fade_start, PS_CLIP_POS.w);
}

// Level 2. Preserve the screen ellipse, but project each view ray onto the
// player's upright plane before extending its rounded, soft back boundary.
float EllipseReveal(vec2 screen_pos, float strength)
{
    if (strength <= 0.0 || PS_REVEAL_CENTRE.z <= 0.001)
    {
        return 0.0;
    }

    vec2 offset = (screen_pos - PS_REVEAL_CENTRE.xy) * PS_NDC_TO_VIEW * PS_REVEAL_CENTRE.z;
    float spread = length(offset / REVEAL_RADII);
    float reveal = 1.0 - smoothstep(REVEAL_CORE, 1.0, spread);
    float radial = min(spread, 1.0);
    float ray_plane = PS_REVEAL_PLANE.y / PS_CLIP_POS.w;
    // Parallel rays, a plane through the eye, or intersections behind the eye
    // have no finite forward projection. Near-camera/top fades still apply.
    if (PS_REVEAL_PLANE.x <= 0.001 || ray_plane <= 0.001)
    {
        return 0.0;
    }
    float plane_depth = PS_REVEAL_PLANE.x / ray_plane;
    float depth_limit = plane_depth + REVEAL_DEPTH * sqrt(max(0.0, 1.0 - radial * radial));
    float depth_fade = 1.0 - smoothstep(depth_limit - REVEAL_DEPTH_SOFT, depth_limit + REVEAL_DEPTH_SOFT, PS_CLIP_POS.w);
    return strength * reveal * depth_fade;
}

// Ink lines are darker than the paint around them. Comparing with a blurred
// mip finds the strokes of the light, dark and snowy variants alike.
float InkAmount(vec4 colour, vec4 blurred)
{
    float around = dot(blurred.rgb, LUMA) / max(blurred.a, 0.01);
    return smoothstep(0.04, 0.12, around - dot(colour.rgb, LUMA));
}

void main()
{
    vec4 colour;
    vec4 blurred;

    // The blurred sample stays outside per-pixel branches so its mip
    // derivatives are well defined.
#if defined( TRIPLE_ATLAS )
    if( PS_TEXCOORD.z < 0.5 )
    {
        colour.rgba = texture2D( SAMPLER[0], PS_TEXCOORD.xy );
        blurred = texture2D( SAMPLER[0], PS_TEXCOORD.xy, INK_BLUR_BIAS );
    }
    else if( PS_TEXCOORD.z < 1.5 )
    {
        colour.rgba = texture2D( SAMPLER[1], PS_TEXCOORD.xy );
        blurred = texture2D( SAMPLER[1], PS_TEXCOORD.xy, INK_BLUR_BIAS );
    }
    else
    {
        colour.rgba = texture2D( SAMPLER[5], PS_TEXCOORD.xy );
        blurred = texture2D( SAMPLER[5], PS_TEXCOORD.xy, INK_BLUR_BIAS );
    }
#else
    if( PS_TEXCOORD.z < 0.5 )
    {
        colour.rgba = texture2D( SAMPLER[0], PS_TEXCOORD.xy );
        blurred = texture2D( SAMPLER[0], PS_TEXCOORD.xy, INK_BLUR_BIAS );
    }
    else
    {
        colour.rgba = texture2D( SAMPLER[1], PS_TEXCOORD.xy );
        blurred = texture2D( SAMPLER[1], PS_TEXCOORD.xy, INK_BLUR_BIAS );
    }
#endif

	if (colour.a < 1.0)
	{
		discard;
	}

    // Player reveal retains ink; near-camera fade can remove the wall entirely.
    // Wall tops remain softly translucent even when neither view effect applies.
    float opacity = 1.0;
    // 0 disables the effect; 1 + strength enables it. Leave room for varying
    // interpolation roundoff when the player reveal strength is exactly zero.
    if (PS_WALL_FADE.x > 0.5 && PS_CLIP_POS.w > 0.001)
    {
        vec2 screen_pos = PS_CLIP_POS.xy / PS_CLIP_POS.w;
        float ink = InkAmount(colour, blurred);
        float reveal = EllipseReveal(screen_pos, PS_WALL_FADE.x - 1.0);
        float reveal_keep = mix(FILL_KEEP, INK_KEEP, ink);
        // Match the vertex shader's wall branch so filler symbols stay opaque.
        float top_fade = PS_WALL_FADE.y > 0.5
            ? smoothstep(TOP_FADE_START, TOP_FADE_END, PS_POS.y) : 0.0;
        float top_keep = mix(1.0, TOP_KEEP, top_fade);
        opacity = min(top_keep, min(1.0 - NearFade(screen_pos), mix(1.0, reveal_keep, reveal)));
    }

    // Fully invisible fragments must not leave depth behind.
    if (opacity <= 0.0)
    {
        discard;
    }

	if (BLOOM_TOGGLE == 1.0)
	{
		gl_FragColor.rgba = vec4(0, 0, 0, colour.a * opacity);
		return;
	}

#if defined ( FADE_OUT )
	if (colour.a >= ALPHA_TEST)
#else
	if (ALPHA_TEST > 0.0)
	{
		if (colour.a >= ALPHA_TEST)
		{
			gl_FragColor = colour.rgba * opacity;
		}
		else
		{
			discard;
		}
	}
    else
#endif
	if (colour.a >= 0.1) 
    {
		gl_FragColor.rgba = colour.rgba;
		gl_FragColor.rgb = min(gl_FragColor.rgb, gl_FragColor.a);


		
		vec2 world_uv = ( PS_POS.xz - OCEAN_WORLD_EXTENTS.xy ) * OCEAN_WORLD_EXTENTS.zw;
		vec3 world_tint = texture2D( OCEAN_SAMPLER, world_uv ).rgb;
		gl_FragColor.rgb = mix(gl_FragColor.rgb, gl_FragColor.rgb * world_tint.rgb, PS_WALL_FADE.z);

        vec3 light = CalculateLightingContribution();
        gl_FragColor.rgb *= light.rgb;
		gl_FragColor.rgba *= vec4(opacity);
	}
	else
		{
			discard;
		}
}
